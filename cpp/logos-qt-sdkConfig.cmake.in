@PACKAGE_INIT@

# logos-qt-sdkConfig.cmake — consumed by `find_package(logos-qt-sdk)`.
# Re-resolves the SDK's dependencies (Qt + logos-protocol, which itself
# propagates Boost / OpenSSL / nlohmann_json) before importing the target.

include(CMakeFindDependencyMacro)

find_dependency(Qt6 REQUIRED COMPONENTS Core RemoteObjects)
find_dependency(logos-protocol REQUIRED)

# logos_qt_sdk carries no code of its own any more: the Qt host runtime lives in
# logos-qt-host and this package re-exports it. Resolving it here is what keeps
# `find_package(logos-qt-sdk)` a complete request — a consumer gets the same
# headers and the same archive it always did, without naming a second package.
#
# The baked HINTS is the prefix logos-qt-host was found at when this package was
# built; it is consulted after CMAKE_PREFIX_PATH, so it is a fallback for
# consumers that locate this package by an explicit NO_DEFAULT_PATH, never an
# override.
if(NOT TARGET logos-qt-host::logos_qt_host)
    find_package(logos-qt-host REQUIRED CONFIG HINTS "@LOGOS_QT_HOST_HINT@")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/logos-qt-sdkTargets.cmake")

check_required_components(logos-qt-sdk)
